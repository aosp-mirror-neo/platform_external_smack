package {
    default_applicable_licenses: ["external_smack_license"],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
// See: http://go/android-license-faq
license {
    name: "external_smack_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

java_library {
    name: "smack-core",
    srcs: ["smack-core/src/main/java/org/jivesoftware/**/*.java"],
    java_resource_dirs: ["smack-core/src/main/resources"],
    static_libs: [
        "minidns-core",
        "jxmpp-core",
        "jxmpp-jid",
        "smack-xmlparser",
    ],
    sdk_version: "current",
    visibility: ["//vendor:__subpackages__"],
    errorprone: {
        javacflags: ["-Xep:ReturnValueIgnored:OFF"],
    },
}

java_library {
    name: "smack-xmlparser",
    srcs: ["smack-xmlparser/src/main/java/org/jivesoftware/**/*.java"],
    sdk_version: "current",
    visibility: ["//vendor:__subpackages__"],
}

java_library {
    name: "smack-android",
    srcs: ["smack-android/src/main/java/org/jivesoftware/**/*.java"],
    static_libs: [
        "minidns-core",
        "smack-core",
        "smack-xmlparser",
        "minidns-android23",
    ],
    sdk_version: "current",
    visibility: ["//vendor:__subpackages__"],
}

